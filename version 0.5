    // Build smooth Catmull-Rom spline for a track
    function buildSplineTrack(waypoints, subdivisions = 22) {
      const pts = [];
      const n = waypoints.length;
      for (let i = 0; i < n; i++) {
        const p0 = waypoints[(i - 1 + n) % n];
        const p1 = waypoints[i];
        const p2 = waypoints[(i + 1) % n];
        const p3 = waypoints[(i + 2) % n];

        for (let step = 0; step < subdivisions; step++) {
          const t = step / subdivisions;
          const t2 = t * t;
          const t3 = t2 * t;

          const x = 0.5 * (
            (2 * p1.x) +
            (-p0.x + p2.x) * t +
            (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 +
            (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3
          );
          const y = 0.5 * (
            (2 * p1.y) +
            (-p0.y + p2.y) * t +
            (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 +
            (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3
          );
          pts.push({
            x,
            y,
            wpIndex: i,
            isWpStart: step === 0,
            turnTag: step === 0 ? (p1.turnTag || '') : '',
            chevron: step === 0 ? (p1.chevron || '') : '',
            sector: p1.sector,
            drs: p1.drs,
            bridge: Boolean(p1.bridge),
            underpass: Boolean(p1.underpass),
            tunnel: Boolean(p1.tunnel),
            cornerName: p1.name
          });
        }
      }
      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      for (let i = 0; i < pts.length; i++) {
        const prev = pts[(i - 1 + pts.length) % pts.length];
        const next = pts[(i + 1) % pts.length];
        const dx = next.x - prev.x;
        const dy = next.y - prev.y;
        const len = Math.hypot(dx, dy) || 1;
        pts[i].tx = dx / len;
        pts[i].ty = dy / len;
        pts[i].nx = -pts[i].ty;
        pts[i].ny = pts[i].tx;
        if (pts[i].x < minX) minX = pts[i].x;
        if (pts[i].x > maxX) maxX = pts[i].x;
        if (pts[i].y < minY) minY = pts[i].y;
        if (pts[i].y > maxY) maxY = pts[i].y;
      }
      return { pts, bounds: { minX, maxX, minY, maxY } };
    }

    // Precompute splines & scenery for all 3 circuits
    const compiledTracks = {};
    Object.keys(TRACKS).forEach(key => {
      const cfg = TRACKS[key];
      const { pts, bounds } = buildSplineTrack(cfg.waypoints, 22);
      const scenery = [];
      let seed = key === 'imola' ? 108 : (key === 'suzuka' ? 204 : 309);
      function rand() {
        seed = (seed * 1664525 + 1013904223) % 4294967296;
        return seed / 4294967296;
      }
      for (let i = 0; i < 480; i++) {
        const rx = (bounds.minX - 500) + rand() * (bounds.maxX - bounds.minX + 1000);
        const ry = (bounds.minY - 500) + rand() * (bounds.maxY - bounds.minY + 1000);
        let minDist = Infinity;
        for (let j = 0; j < pts.length; j += 3) {
          const d = Math.hypot(rx - pts[j].x, ry - pts[j].y);
          if (d < minDist) minDist = d;
        }
        if (minDist > cfg.trackWidth * 0.92) {
          scenery.push({
            x: rx,
            y: ry,
            type: rand() > 0.22 ? 'primary' : 'grandstand',
            size: 18 + Math.floor(rand() * 16),
            shade: cfg.sceneryType === 'monaco'
              ? (rand() > 0.5 ? '#e2e8f0' : '#94a3b8')
              : (rand() > 0.5 ? '#15803d' : '#166534')
          });
        }
      }
      compiledTracks[key] = { cfg, pts, bounds, scenery, bestLapMs: null, ghostData: null };
    });

    let selectedTrackKey = 'imola';
    let selectedLaps = 3;

    // =========================================================================
    // 3. SYNTHESIZED RETRO AUDIO (Web Audio API)
    // =========================================================================
    let audioCtx = null;
    let engineOsc = null;
    let engineGain = null;
    let screechNode = null;
    let screechGain = null;
    let curbOsc = null;
    let curbGain = null;
    let isMuted = false;

    function initAudio() {
      if (audioCtx) return;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        audioCtx = new AudioContextClass();

        engineOsc = audioCtx.createOscillator();
        engineOsc.type = 'sawtooth';
        engineOsc.frequency.value = 55;

        const engineFilter = audioCtx.createBiquadFilter();
        engineFilter.type = 'lowpass';
        engineFilter.frequency.value = 340;

        engineGain = audioCtx.createGain();
        engineGain.gain.value = 0.0;

        engineOsc.connect(engineFilter);
        engineFilter.connect(engineGain);
        engineGain.connect(audioCtx.destination);
        engineOsc.start();

        const bufferSize = audioCtx.sampleRate * 1.0;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }
        screechNode = audioCtx.createBufferSource();
        screechNode.buffer = noiseBuffer;
        screechNode.loop = true;

        const bandpass = audioCtx.createBiquadFilter();
        bandpass.type = 'bandpass';
        bandpass.frequency.value = 1100;
        bandpass.Q.value = 3.5;

        screechGain = audioCtx.createGain();
        screechGain.gain.value = 0.0;

        screechNode.connect(bandpass);
        bandpass.connect(screechGain);
        screechGain.connect(audioCtx.destination);
        screechNode.start();

        curbOsc = audioCtx.createOscillator();
        curbOsc.type = 'square';
        curbOsc.frequency.value = 88;
        curbGain = audioCtx.createGain();
        curbGain.gain.value = 0.0;
        curbOsc.connect(curbGain);
        curbGain.connect(audioCtx.destination);
        curbOsc.start();
      } catch (e) {}
    }

    let lastCurbVibeTime = 0;
    function updateAudio(speedRatio, isDrifting, onCurb) {
      if (!audioCtx || isMuted) {
        if (engineGain) engineGain.gain.value = 0;
        if (screechGain) screechGain.gain.value = 0;
        if (curbGain) curbGain.gain.value = 0;
        return;
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      const baseFreq = 52 + speedRatio * 170;
      engineOsc.frequency.setTargetAtTime(baseFreq, audioCtx.currentTime, 0.04);
      engineGain.gain.setTargetAtTime(0.045 + speedRatio * 0.04, audioCtx.currentTime, 0.05);

      const targetScreech = isDrifting ? 0.065 : 0.0;
      screechGain.gain.setTargetAtTime(targetScreech, audioCtx.currentTime, 0.05);

      const targetCurb = (onCurb && speedRatio > 0.15) ? 0.045 : 0.0;
      if (curbGain) curbGain.gain.setTargetAtTime(targetCurb, audioCtx.currentTime, 0.03);

      if (onCurb && speedRatio > 0.25) {
        const nowMs = performance.now();
        if (nowMs - lastCurbVibeTime > 140) {
          lastCurbVibeTime = nowMs;
          if (navigator.vibrate) {
            try { navigator.vibrate(18); } catch (e) {}
          }
        }
      }
    }

    function playCheckpointBeep(freq = 660) {
      if (!audioCtx || isMuted) return;
      try {
        const osc = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.value = freq;
        g.gain.value = 0.06;
        osc.connect(g);
        g.connect(audioCtx.destination);
        osc.start();
        g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.18);
        osc.stop(audioCtx.currentTime + 0.19);
      } catch (e) {}
    }

    // =========================================================================
    // 4. PLAYER CAR, GHOST CAR & ROBUST FINISH LINE CROSSING STATE
    // =========================================================================
    let selectedCarKey = 'balanced';
    const car = {
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      angle: Math.PI,
      speed: 0,
      isDrifting: false,
      drsActive: false,
      surface: 'asphalt',
      closestSplineIdx: 0
    };

    const skidMarks = [];
    const MAX_SKID_MARKS = 420;
    const smokeParticles = [];

    let ghostEnabled = true;
    let currentLapRecording = [];
    let ghostCarState = {
      x: 0,
      y: 0,
      angle: 0,
      speed: 0,
      isDrifting: false,
      visible: false
    };

    const raceState = {
      lap: 1,
      totalLaps: 3,
      lapTimes: [],
      lapStartTime: performance.now(),
      curLapTime: 0,
      passedSector1: false,
      passedSector2: false,
      s1Time: null,
      s2Time: null,
      s3Time: null,
      maxSplineIdxReached: 0,
      finished: false
    };

    function getActiveTrack() {
      return compiledTracks[selectedTrackKey];
    }

    function resetCarToStart() {
      const active = getActiveTrack();
      const startPt = active.pts[0];
      car.x = startPt.x;
      car.y = startPt.y;
      car.vx = 0;
      car.vy = 0;
      car.angle = Math.atan2(startPt.ty, startPt.tx);
      car.speed = 0;
      car.isDrifting = false;
      car.drsActive = false;
      car.closestSplineIdx = 0;

      raceState.lap = 1;
      raceState.totalLaps = selectedLaps;
      raceState.lapTimes = [];
      raceState.finished = false;
      raceState.lapStartTime = performance.now();
      raceState.passedSector1 = false;
      raceState.passedSector2 = false;
      raceState.maxSplineIdxReached = 0;

      const hudBadge = document.getElementById('hudTrackBadge');
      hudBadge.textContent = active.cfg.badgeText;
      hudBadge.className = `inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded text-[10px] sm:text-[11px] font-extrabold text-white tracking-wider uppercase mono shrink-0 ${active.cfg.badgeColor}`;
      document.getElementById('hudTrackFullName').textContent = active.cfg.fullName;
      document.getElementById('minimapTitle').textContent = active.cfg.shortTitle;

      document.getElementById('hudLap').textContent = `1/${raceState.totalLaps}`;
      document.getElementById('hudBestTime').textContent = active.bestLapMs ? formatTime(active.bestLapMs) : '--:--.--';
      document.getElementById('hudSector1').textContent = 'S1:--';
      document.getElementById('hudSector2').textContent = 'S2:--';
      document.getElementById('hudSector3').textContent = 'S3:--';

      skidMarks.length = 0;
      smokeParticles.length = 0;
      currentLapRecording = [];
    }

    // =========================================================================
    // 5. INPUT HANDLING: PC WASD + MOBILE AUTO-ACCELERATE
    // =========================================================================
    const input = {
      left: false,
      right: false,
      gas: false,
      brake: false,
      handbrake: false
    };

    let autoAccelerate = true;
    let usingKeyboardGas = false;
    const btnToggleAutoGas = document.getElementById('btnToggleAutoGas');
    const btnPedalGas = document.getElementById('btnPedalGas');

    function updateAutoGasUI() {
      if (autoAccelerate && !usingKeyboardGas) {
        btnToggleAutoGas.textContent = '⚡自動:開';
        btnToggleAutoGas.className = 'px-1 sm:px-2 py-1 rounded bg-emerald-950/90 hover:bg-emerald-900 text-[10px] sm:text-[11px] font-semibold text-emerald-200 border border-emerald-700/80 transition text-center whitespace-nowrap';
        btnPedalGas.classList.add('hidden');
      } else {
        btnToggleAutoGas.textContent = '⚡自動:關';
        btnToggleAutoGas.className = 'px-1 sm:px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[10px] sm:text-[11px] font-semibold text-slate-300 border border-slate-700 transition text-center whitespace-nowrap';
        btnPedalGas.classList.remove('hidden');
      }
    }

    btnToggleAutoGas.addEventListener('click', () => {
      autoAccelerate = !autoAccelerate;
      usingKeyboardGas = false;
      updateAutoGasUI();
      showToast(
        autoAccelerate ? '自動加速已開啟' : '手動油門模式',
        autoAccelerate ? '手機免按油門，只需控制減速與方向' : '請使用 GAS 鍵或鍵盤 W 加速'
      );
    });

    window.addEventListener('keydown', (e) => {
      initAudio();
      const code = e.code;
      if (code === 'ArrowLeft' || code === 'KeyA') input.left = true;
      if (code === 'ArrowRight' || code === 'KeyD') input.right = true;
      if (code === 'ArrowUp' || code === 'KeyW') {
        input.gas = true;
        if (!usingKeyboardGas) {
          usingKeyboardGas = true;
          updateAutoGasUI();
        }
      }
      if (code === 'ArrowDown' || code === 'KeyS') input.brake = true;
      if (code === 'Space') input.handbrake = true;
    });

    window.addEventListener('keyup', (e) => {
      const code = e.code;
      if (code === 'ArrowLeft' || code === 'KeyA') input.left = false;
      if (code === 'ArrowRight' || code === 'KeyD') input.right = false;
      if (code === 'ArrowUp' || code === 'KeyW') input.gas = false;
      if (code === 'ArrowDown' || code === 'KeyS') input.brake = false;
      if (code === 'Space') input.handbrake = false;
    });

    function bindTouchButton(btnId, inputKey) {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      const activate = (e) => {
        e.preventDefault();
        initAudio();
        if (usingKeyboardGas && autoAccelerate) {
          usingKeyboardGas = false;
          updateAutoGasUI();
        }
        input[inputKey] = true;
        btn.classList.add('active');
      };
      const deactivate = (e) => {
        e.preventDefault();
        input[inputKey] = false;
        btn.classList.remove('active');
      };
      btn.addEventListener('pointerdown', activate);
      btn.addEventListener('pointerup', deactivate);
      btn.addEventListener('pointerleave', deactivate);
      btn.addEventListener('pointercancel', deactivate);
    }

    bindTouchButton('btnSteerLeft', 'left');
    bindTouchButton('btnSteerRight', 'right');
    bindTouchButton('btnPedalGas', 'gas');
    bindTouchButton('btnPedalBrake', 'brake');

    const padPresets = [
      { cls: 'thumb-zone-low', label: '📱高度:低' },
      { cls: 'thumb-zone-mid', label: '📱高度:中' },
      { cls: 'thumb-zone-high', label: '📱高度:高' }
    ];
    let curPadPresetIdx = 1;
    const touchControlsBar = document.getElementById('touchControlsBar');
    const btnTogglePadHeight = document.getElementById('btnTogglePadHeight');

    btnTogglePadHeight.addEventListener('click', () => {
      touchControlsBar.classList.remove(padPresets[curPadPresetIdx].cls);
      curPadPresetIdx = (curPadPresetIdx + 1) % padPresets.length;
      touchControlsBar.classList.add(padPresets[curPadPresetIdx].cls);
      btnTogglePadHeight.textContent = padPresets[curPadPresetIdx].label;
      showToast('觸控按鈕位置已調整', padPresets[curPadPresetIdx].label.replace('📱 ', ''));
    });

    // =========================================================================
    // 6. MAIN MENU SELECTION (Track, Laps, Car) & RESULTS MODAL
    // =========================================================================
    const garageModal = document.getElementById('garageModal');
    const resultModal = document.getElementById('resultModal');
    const btnCarSelect = document.getElementById('btnCarSelect');
    const btnCloseGarage = document.getElementById('btnCloseGarage');
    const btnStartRace = document.getElementById('btnStartRace');
    const btnResetCar = document.getElementById('btnResetCar');
    const btnToggleMute = document.getElementById('btnToggleMute');
    const btnToggleGhost = document.getElementById('btnToggleGhost');
    const btnResultToMenu = document.getElementById('btnResultToMenu');
    const btnResultRaceAgain = document.getElementById('btnResultRaceAgain');
    const modeTimeTrial = document.getElementById('modeTimeTrial');

    function updateMenuSummary() {
      const tCfg = TRACKS[selectedTrackKey];
      const cCfg = CAR_SPECS[selectedCarKey];
      document.getElementById('menuSummaryText').innerHTML =
        `🏁 出戰設定：<strong class="text-white">${tCfg.name} (${tCfg.difficultyLabel})</strong> · <strong class="text-amber-300">${selectedLaps} 圈計時模式</strong> · <strong class="text-red-400">${cCfg.shortName}</strong>`;
    }

    function selectTrack(trackKey) {
      if (!TRACKS[trackKey]) return;
      selectedTrackKey = trackKey;
      document.querySelectorAll('.track-card').forEach(card => {
        const isSel = card.getAttribute('data-track') === trackKey;
        const borderCol = trackKey === 'imola' ? 'border-emerald-500' : (trackKey === 'suzuka' ? 'border-sky-400' : 'border-amber-400');
        card.className = isSel
          ? `track-card cursor-pointer rounded-xl p-3 bg-slate-800/95 border-2 ${borderCol} transition flex flex-col justify-between shadow-lg`
          : 'track-card cursor-pointer rounded-xl p-3 bg-slate-800/50 border-2 border-slate-700 transition hover:bg-slate-800 flex flex-col justify-between';
      });
      resetCarToStart();
      camX = car.x - viewW / 2;
      camY = car.y - viewH / 2;
      updateMenuSummary();
    }

    function selectLaps(lapsCount) {
      selectedLaps = lapsCount;
      document.querySelectorAll('.lap-btn').forEach(btn => {
        const isSel = Number(btn.getAttribute('data-laps')) === lapsCount;
        btn.className = isSel
          ? 'lap-btn px-2.5 py-1 rounded bg-amber-500 text-slate-950 text-xs font-extrabold mono border border-amber-400 shadow'
          : 'lap-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold mono border border-slate-700';
      });
      updateMenuSummary();
    }

    function selectCar(carKey) {
      if (!CAR_SPECS[carKey]) return;
      selectedCarKey = carKey;
      document.querySelectorAll('.car-card').forEach((card) => {
        const isSelected = card.getAttribute('data-car') === carKey;
        card.className = isSelected
          ? 'car-card cursor-pointer rounded-xl p-3 bg-slate-800/95 border-2 border-red-500 transition flex flex-col justify-between shadow-lg'
          : 'car-card cursor-pointer rounded-xl p-3 bg-slate-800/50 border-2 border-slate-700 transition hover:bg-slate-800 flex flex-col justify-between';
      });
      document.getElementById('hudCarTitle').textContent = CAR_SPECS[carKey].shortName;
      updateMenuSummary();
    }

    document.querySelectorAll('.track-card').forEach(card => {
      card.addEventListener('click', () => {
        initAudio();
        selectTrack(card.getAttribute('data-track'));
      });
    });

    document.querySelectorAll('.lap-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        initAudio();
        selectLaps(Number(btn.getAttribute('data-laps')));
      });
    });

    document.querySelectorAll('.car-card').forEach((card) => {
      card.addEventListener('click', () => {
        initAudio();
        selectCar(card.getAttribute('data-car'));
      });
    });

    modeTimeTrial.addEventListener('click', () => {
      initAudio();
      showToast('⏱️ 計時模式 (Time Trial)', '可自由選擇賽道、車款與挑戰圈數');
    });

    btnCarSelect.addEventListener('click', () => {
      resultModal.classList.add('hidden');
      btnCloseGarage.classList.remove('hidden');
      garageModal.classList.remove('hidden');
    });
    btnCloseGarage.addEventListener('click', () => {
      initAudio();
      garageModal.classList.add('hidden');
    });
    btnStartRace.addEventListener('click', () => {
      initAudio();
      garageModal.classList.add('hidden');
      resultModal.classList.add('hidden');
      resetCarToStart();
      showToast(`${TRACKS[selectedTrackKey].shortTitle} ${selectedLaps}-LAP START!`, `${CAR_SPECS[selectedCarKey].name} 出站`);
    });
    btnResetCar.addEventListener('click', () => {
      resetCarToStart();
      showToast('CAR RESET', `已重新開始 ${TRACKS[selectedTrackKey].name} (${selectedLaps} 圈)`);
    });
    btnToggleMute.addEventListener('click', () => {
      initAudio();
      isMuted = !isMuted;
      btnToggleMute.textContent = isMuted ? '🔇音效:關' : '🔊音效:開';
    });
    btnToggleGhost.addEventListener('click', () => {
      ghostEnabled = !ghostEnabled;
      btnToggleGhost.textContent = ghostEnabled ? '👻殘影:開' : '👻殘影:關';
      showToast('Ghost Car 設定更新', ghostEnabled ? '已啟用最佳單圈殘影重播' : '已隱藏 Ghost 殘影');
    });

    btnResultToMenu.addEventListener('click', () => {
      resultModal.classList.add('hidden');
      btnCloseGarage.classList.add('hidden');
      garageModal.classList.remove('hidden');
    });
    btnResultRaceAgain.addEventListener('click', () => {
      initAudio();
      resultModal.classList.add('hidden');
      resetCarToStart();
      showToast('NEW TIME TRIAL START!', '挑戰更快總成績！');
    });

    function showRaceResultsModal() {
      raceState.finished = true;
      updateAudio(0, false, false);
      const active = getActiveTrack();
      const totalMs = raceState.lapTimes.reduce((a, b) => a + b, 0);
      const bestSingleMs = Math.min(...raceState.lapTimes);

      document.getElementById('resTitle').textContent = `${active.cfg.name} (${raceState.totalLaps} 圈) 完賽結算`;
      document.getElementById('resCarUsed').textContent = `難度：${active.cfg.difficultyLabel} ｜ 車輛：${CAR_SPECS[selectedCarKey].name}`;
      document.getElementById('resTotalLabel').textContent = `${raceState.totalLaps} 圈總時間 (TOTAL)`;
      document.getElementById('resTotalTime').textContent = formatTime(totalMs);
      document.getElementById('resBestLap').textContent = formatTime(bestSingleMs);

      const listEl = document.getElementById('resLapList');
      listEl.innerHTML = raceState.lapTimes.map((ms, idx) => {
        const isBest = ms === bestSingleMs && raceState.lapTimes.length > 1;
        return `
          <div class="flex justify-between items-center ${idx > 0 ? 'border-t border-slate-800/80 pt-1.5' : ''}">
            <span class="text-slate-400">LAP ${idx + 1}</span>
            <span class="font-bold ${isBest ? 'text-amber-400' : 'text-white'}">${formatTime(ms)} ${isBest ? '★' : ''}</span>
          </div>
        `;
      }).join('');

      resultModal.classList.remove('hidden');
    }

    let toastTimeout = null;
    function showToast(title, sub) {
      const toast = document.getElementById('centerToast');
      document.getElementById('centerToastTitle').textContent = title;
      document.getElementById('centerToastSub').textContent = sub;
      toast.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2200);
    }

    function formatTime(ms) {
      const totalSec = ms / 1000;
      const mins = Math.floor(totalSec / 60);
      const secs = Math.floor(totalSec % 60);
      const hundredths = Math.floor((ms % 1000) / 10);
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}.${String(hundredths).padStart(2, '0')}`;
    }

    // =========================================================================
    // 7. PHYSICS, GHOST CAR & INFALLIBLE FINISH LINE DETECTION
    // =========================================================================
    let lastGhostSampleTime = 0;

    function updateGhostCar(curTime) {
      const active = getActiveTrack();
      const bestGhost = active.ghostData;
      if (!ghostEnabled || !bestGhost || bestGhost.length < 2) {
        ghostCarState.visible = false;
        document.getElementById('hudGhostDelta').textContent = '--.--s';
        document.getElementById('hudGhostDelta').className = 'font-bold text-slate-400 ml-1';
        return;
      }
      ghostCarState.visible = true;

      let idx = 0;
      while (idx < bestGhost.length - 1 && bestGhost[idx + 1].t < curTime) {
        idx++;
      }
      const p1 = bestGhost[idx];
      const p2 = bestGhost[Math.min(bestGhost.length - 1, idx + 1)];

      if (p1 && p2 && p2.t > p1.t) {
        const factor = Math.max(0, Math.min(1, (curTime - p1.t) / (p2.t - p1.t)));
        ghostCarState.x = p1.x + (p2.x - p1.x) * factor;
        ghostCarState.y = p1.y + (p2.y - p1.y) * factor;
        let diffA = p2.angle - p1.angle;
        while (diffA > Math.PI) diffA -= Math.PI * 2;
        while (diffA < -Math.PI) diffA += Math.PI * 2;
        ghostCarState.angle = p1.angle + diffA * factor;
        ghostCarState.speed = p1.speed + (p2.speed - p1.speed) * factor;
        ghostCarState.isDrifting = p1.isDrifting;

        const ghostDistToCar = Math.hypot(car.x - ghostCarState.x, car.y - ghostCarState.y);
        const estSecDelta = (ghostDistToCar / Math.max(160, car.speed));
        const curTrackPt = active.pts[car.closestSplineIdx];
        const aheadDot = (car.x - ghostCarState.x) * curTrackPt.tx + (car.y - ghostCarState.y) * curTrackPt.ty;
        const deltaEl = document.getElementById('hudGhostDelta');
        if (aheadDot >= 0) {
          deltaEl.textContent = `-${estSecDelta.toFixed(2)}s`;
          deltaEl.className = 'font-bold text-emerald-400 ml-1';
        } else {
          deltaEl.textContent = `+${estSecDelta.toFixed(2)}s`;
          deltaEl.className = 'font-bold text-red-400 ml-1';
        }
      }
    }

    function updatePhysics(dt) {
      if (raceState.finished) return;
      const spec = CAR_SPECS[selectedCarKey];
      const active = getActiveTrack();
      const trackSpline = active.pts;
      const trackWidth = active.cfg.trackWidth;
      const curbWidth = active.cfg.curbWidth;

      const prevSplineIdx = car.closestSplineIdx;
      let bestIdx = car.closestSplineIdx;
      let minDist = Infinity;
      const N = trackSpline.length;

      // Local window search (+/- 35 spline indices) keeps car locked to its current bridge/underpass level
      for (let offset = -35; offset <= 35; offset++) {
        const idx = (car.closestSplineIdx + offset + N) % N;
        const d = Math.hypot(car.x - trackSpline[idx].x, car.y - trackSpline[idx].y);
        if (d < minDist) {
          minDist = d;
          bestIdx = idx;
        }
      }
      if (minDist > trackWidth * 1.65) {
        for (let i = 0; i < N; i++) {
          const d = Math.hypot(car.x - trackSpline[i].x, car.y - trackSpline[i].y);
          if (d < minDist) {
            minDist = d;
            bestIdx = i;
          }
        }
      }
      car.closestSplineIdx = bestIdx;
      const curTrackPt = trackSpline[bestIdx];

      const halfRoad = trackWidth * 0.5;
      if (minDist <= halfRoad - curbWidth * 0.5) {
        car.surface = 'asphalt';
      } else if (minDist <= halfRoad + curbWidth * 0.65) {
        car.surface = 'curb';
      } else {
        car.surface = 'grass';
      }

      const cosA = Math.cos(car.angle);
      const sinA = Math.sin(car.angle);
      let forwardVel = car.vx * cosA + car.vy * sinA;
      let lateralVel = -car.vx * sinA + car.vy * cosA;

      const absSpeed = Math.hypot(car.vx, car.vy);
      car.speed = absSpeed;

      const effectiveGas = input.gas || (autoAccelerate && !usingKeyboardGas && !input.brake);

      car.drsActive = Boolean(curTrackPt.drs && effectiveGas && !input.brake && car.surface !== 'grass' && absSpeed > 260);

      const steerInput = (input.right ? 1 : 0) - (input.left ? 1 : 0);
      const speedFactor = Math.min(1, absSpeed / 120);
      const reverseSign = forwardVel >= -10 ? 1 : -1;
      const curbTurnBonus = car.surface === 'curb' ? 1.14 : 1.0;

      const wantsToDrift =
        (steerInput !== 0 && absSpeed > spec.driftThreshold) ||
        (steerInput !== 0 && (input.brake || input.handbrake) && absSpeed > 180) ||
        Math.abs(lateralVel) > 105;

      car.isDrifting = wantsToDrift;

      const effectiveTurnRate = spec.turnSpeed * curbTurnBonus * (car.isDrifting ? 1.2 : 1.0);
      car.angle += steerInput * effectiveTurnRate * speedFactor * reverseSign * dt;

      const drsBoost = car.drsActive ? 1.07 : 1.0;
      if (effectiveGas) {
        forwardVel += spec.accel * drsBoost * dt;
      }
      if (input.brake) {
        if (forwardVel > 20) {
          forwardVel -= spec.brake * dt;
        } else {
          forwardVel -= spec.accel * 0.5 * dt;
        }
      }

      let maxAllowedSpeed = spec.maxSpeed * drsBoost;
      let rollingDrag = 0.65;
      if (car.surface === 'grass') {
        maxAllowedSpeed = spec.maxSpeed * 0.52;
        rollingDrag = 3.2;
      } else if (car.surface === 'curb') {
        rollingDrag = 0.85;
      }

      if (!effectiveGas && !input.brake) {
        forwardVel *= Math.max(0, 1 - rollingDrag * dt);
      }
      if (car.surface === 'grass' && forwardVel > maxAllowedSpeed) {
        forwardVel -= 450 * dt;
      }
      forwardVel = Math.max(-180, Math.min(maxAllowedSpeed, forwardVel));

      const traction = car.isDrifting
        ? spec.driftTraction
        : (car.surface === 'grass' ? spec.gripTraction * 0.45 : spec.gripTraction);

      if (car.isDrifting && steerInput !== 0) {
        lateralVel += -steerInput * 145 * dt;
        forwardVel *= Math.pow(spec.driftRetention, dt * 60);
      }

      lateralVel *= Math.max(0, 1 - traction * dt);

      const newCos = Math.cos(car.angle);
      const newSin = Math.sin(car.angle);
      car.vx = forwardVel * newCos - lateralVel * newSin;
      car.vy = forwardVel * newSin + lateralVel * newCos;

      car.x += car.vx * dt;
      car.y += car.vy * dt;

      // Barrier containment so car never jumps onto another road segment
      if (minDist > trackWidth * 1.18) {
        const pullX = curTrackPt.x - car.x;
        const pullY = curTrackPt.y - car.y;
        const plen = Math.hypot(pullX, pullY) || 1;
        car.x += (pullX / plen) * (minDist - trackWidth * 1.18);
        car.y += (pullY / plen) * (minDist - trackWidth * 1.18);
        car.vx *= 0.68;
        car.vy *= 0.68;
      }

      if ((car.isDrifting || car.surface === 'grass') && absSpeed > 140) {
        const rearOffset = -14;
        const tireSpread = 8;
        const rx = car.x + Math.cos(car.angle) * rearOffset;
        const ry = car.y + Math.sin(car.angle) * rearOffset;
        const px = -Math.sin(car.angle) * tireSpread;
        const py = Math.cos(car.angle) * tireSpread;

        skidMarks.push({
          x1: rx + px,
          y1: ry + py,
          x2: rx - px,
          y2: ry - py,
          color: car.surface === 'grass' ? 'rgba(63, 46, 33, 0.55)' : 'rgba(15, 23, 42, 0.55)'
        });
        if (skidMarks.length > MAX_SKID_MARKS) skidMarks.shift();

        if (Math.random() < 0.65) {
          smokeParticles.push({
            x: rx + (Math.random() - 0.5) * 14,
            y: ry + (Math.random() - 0.5) * 14,
            vx: (Math.random() - 0.5) * 30,
            vy: (Math.random() - 0.5) * 30,
            size: 5 + Math.random() * 5,
            alpha: 0.75,
            color: car.surface === 'grass' ? '#a16207' : '#e2e8f0'
          });
        }
      }

      for (let i = smokeParticles.length - 1; i >= 0; i--) {
        const p = smokeParticles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.size += 12 * dt;
        p.alpha -= 1.1 * dt;
        if (p.alpha <= 0) smokeParticles.splice(i, 1);
      }

      // Timing & Recording
      const now = performance.now();
      raceState.curLapTime = now - raceState.lapStartTime;

      if (now - lastGhostSampleTime > 50) {
        lastGhostSampleTime = now;
        currentLapRecording.push({
          t: raceState.curLapTime,
          x: car.x,
          y: car.y,
          angle: car.angle,
          speed: car.speed,
          isDrifting: car.isDrifting
        });
      }

      updateGhostCar(raceState.curLapTime);

      if (curTrackPt.sector === 2 && !raceState.passedSector1) {
        raceState.passedSector1 = true;
        raceState.s1Time = (raceState.curLapTime / 1000).toFixed(1);
        document.getElementById('hudSector1').textContent = `S1:${raceState.s1Time}`;
        playCheckpointBeep(587.33);
      }
      if (curTrackPt.sector === 3 && raceState.passedSector1 && !raceState.passedSector2) {
        raceState.passedSector2 = true;
        raceState.s2Time = (raceState.curLapTime / 1000).toFixed(1);
        document.getElementById('hudSector2').textContent = `S2:${raceState.s2Time}`;
        playCheckpointBeep(659.25);
      }
      if (bestIdx > raceState.maxSplineIdxReached) {
        raceState.maxSplineIdxReached = bestIdx;
      }

      // Infallible Finish Line Detection:
      // Triggers as soon as car wraps around from the end of Sector 3 (index > 75% of N)
      // into the Start/Finish zone (index < 45), OR crosses the Finish Line plane after S1 & S2!
      const wrappedAroundFinish = (prevSplineIdx > N * 0.75 && bestIdx < 45);
      const inFinishZoneAfterFullLap = (bestIdx < 32 && raceState.passedSector1 && raceState.passedSector2 && raceState.maxSplineIdxReached > N * 0.72);

      if ((wrappedAroundFinish || inFinishZoneAfterFullLap) && raceState.curLapTime > 5000) {
        const finishedLapMs = raceState.curLapTime;
        raceState.s3Time = (finishedLapMs / 1000).toFixed(1);
        document.getElementById('hudSector3').textContent = `S3:${raceState.s3Time}`;
        raceState.lapTimes.push(finishedLapMs);

        if (active.bestLapMs === null || finishedLapMs < active.bestLapMs) {
          active.bestLapMs = finishedLapMs;
          active.ghostData = [...currentLapRecording];
          document.getElementById('hudBestTime').textContent = formatTime(active.bestLapMs);
          const menuBestEl = document.getElementById(`menuBest-${selectedTrackKey}`);
          if (menuBestEl) menuBestEl.textContent = formatTime(active.bestLapMs);
          showToast('🟣 FASTEST LAP & GHOST SAVED!', `新紀錄: ${formatTime(finishedLapMs)}`);
        } else {
          showToast(`🏁 LAP ${raceState.lap} 完成`, `單圈時間: ${formatTime(finishedLapMs)}`);
        }
        playCheckpointBeep(880);

        if (raceState.lap >= raceState.totalLaps) {
          showRaceResultsModal();
          return;
        } else {
          raceState.lap += 1;
          document.getElementById('hudLap').textContent = `${raceState.lap}/${raceState.totalLaps}`;
          raceState.lapStartTime = now;
          raceState.passedSector1 = false;
          raceState.passedSector2 = false;
          raceState.maxSplineIdxReached = 0;
          currentLapRecording = [];
        }
      }

      // Update HUD
      const kmh = Math.round(absSpeed * 0.47);
      document.getElementById('hudSpeed').textContent = kmh;
      document.getElementById('hudSpeedBar').style.width = `${Math.min(100, (kmh / 345) * 100)}%`;
      document.getElementById('hudCurTime').textContent = formatTime(raceState.curLapTime);

      const drsBadge = document.getElementById('hudDrsBadge');
      if (car.drsActive) {
        drsBadge.textContent = 'DRS ON';
        drsBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-extrabold mono bg-emerald-500/30 text-emerald-300 border border-emerald-400';
      } else if (curTrackPt.drs) {
        drsBadge.textContent = 'DRS ZONE';
        drsBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-extrabold mono bg-emerald-950 text-emerald-400 border border-emerald-700';
      } else {
        drsBadge.textContent = 'DRS OFF';
        drsBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-extrabold mono bg-slate-800/90 text-slate-400 border border-slate-700';
      }

      const gripBadge = document.getElementById('hudGripState');
      if (car.isDrifting) {
        gripBadge.textContent = '🔥 DRIFT 高速飄移';
        gripBadge.className = 'px-1.5 py-0.5 rounded font-bold mono text-[10px] bg-amber-500/25 text-amber-300 border border-amber-400 truncate w-full text-center';
      } else {
        gripBadge.textContent = '🟢 GRIP 貼地抓地';
        gripBadge.className = 'px-1.5 py-0.5 rounded font-bold mono text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 truncate w-full text-center';
      }

      const surfEl = document.getElementById('hudSurface');
      if (car.surface === 'asphalt') {
        surfEl.textContent = '柏油(100%)';
        surfEl.className = 'text-slate-300 truncate text-right';
      } else if (car.surface === 'curb') {
        surfEl.textContent = '路緣石(+指向)';
        surfEl.className = 'text-amber-300 font-bold truncate text-right';
      } else {
        surfEl.textContent = active.cfg.sceneryType === 'monaco' ? '⚠️ 護欄減速區' : '⚠️ 草地減速';
        surfEl.className = 'text-red-400 font-bold truncate text-right';
      }

      const lapPct = Math.min(99, Math.floor((bestIdx / N) * 100));
      const cornerText = `📍 ${curTrackPt.cornerName} (${lapPct}%)`;
      document.getElementById('cornerNameBadge').textContent = cornerText;
      document.getElementById('mobileCornerBadge').textContent = cornerText;

      updateAudio(Math.min(1, kmh / 330), car.isDrifting, car.surface === 'curb');
    }

    // =========================================================================
    // 8. PIXEL-ART RENDERER:
    //    - On-Track Turn Labels (T1~T19) & Outer Corner Chevron Arrows (>>>)
    //    - Multi-Pass Overpass Bridge Rendering for Suzuka Figure-8
    //    - Unmistakable Start/Finish Checkered Gantry Banner
    // =========================================================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const minimapCanvas = document.getElementById('minimapCanvas');
    const miniCtx = minimapCanvas.getContext('2d');

    const PIXEL_SCALE = 2;
    let viewW = 640;
    let viewH = 360;

    function resizeCanvas() {
      const container = document.getElementById('gameContainer');
      const rect = container.getBoundingClientRect();
      viewW = Math.max(320, Math.floor(rect.width / PIXEL_SCALE));
      viewH = Math.max(240, Math.floor(rect.height / PIXEL_SCALE));
      canvas.width = viewW;
      canvas.height = viewH;
      ctx.imageSmoothingEnabled = false;
    }

    window.addEventListener('resize', resizeCanvas);

    // Helper to draw a slice of the track spline (used so Suzuka's Overpass Bridge is drawn ON TOP of the Underpass)
    function drawTrackSegmentRange(trackSpline, startIdx, endIdx, trackWidth, curbWidth, runoffColor, curbAltColor, isBridgeDeck = false) {
      const N = trackSpline.length;

      if (isBridgeDeck) {
        // Dark drop shadow under the Suzuka overpass bridge deck
        ctx.beginPath();
        for (let i = startIdx; i <= endIdx; i++) {
          const pt = trackSpline[i % N];
          if (i === startIdx) ctx.moveTo(pt.x + 12, pt.y + 18);
          else ctx.lineTo(pt.x + 12, pt.y + 18);
        }
        ctx.lineCap = 'butt';
        ctx.lineJoin = 'round';
        ctx.lineWidth = trackWidth + curbWidth * 2 + 34;
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.65)';
        ctx.stroke();

        // Steel white/grey bridge guardrails
        ctx.beginPath();
        for (let i = startIdx; i <= endIdx; i++) {
          const pt = trackSpline[i % N];
          if (i === startIdx) ctx.moveTo(pt.x, pt.y);
          else ctx.lineTo(pt.x, pt.y);
        }
        ctx.lineWidth = trackWidth + curbWidth * 2 + 24;
        ctx.strokeStyle = '#e2e8f0';
        ctx.stroke();
      } else {
        // 1. Outer Gravel / Street Barrier Border
        ctx.beginPath();
        for (let i = startIdx; i <= endIdx; i++) {
          const pt = trackSpline[i % N];
          if (i === startIdx) ctx.moveTo(pt.x, pt.y);
          else ctx.lineTo(pt.x, pt.y);
        }
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.lineWidth = trackWidth + curbWidth * 2 + 28;
        ctx.strokeStyle = runoffColor;
        ctx.stroke();
      }

      // 2. Red/White or Blue/White Curbs
      for (let i = startIdx; i < endIdx; i++) {
        const p1 = trackSpline[i % N];
        const p2 = trackSpline[(i + 1) % N];
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.lineWidth = trackWidth + curbWidth;
        ctx.strokeStyle = (i % 2 === 0) ? curbAltColor : '#f8fafc';
        ctx.stroke();
      }

      // 3. Main Asphalt Surface
      ctx.beginPath();
      for (let i = startIdx; i <= endIdx; i++) {
        const pt = trackSpline[i % N];
        if (i === startIdx) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      }
      ctx.lineCap = isBridgeDeck ? 'butt' : 'round';
      ctx.lineJoin = 'round';
      ctx.lineWidth = trackWidth - 6;
      ctx.strokeStyle = '#334155';
      ctx.stroke();

      // 4. Center Racing Line Groove & Direction Chevrons on Asphalt
      ctx.lineWidth = trackWidth * 0.40;
      ctx.strokeStyle = '#1e293b';
      ctx.stroke();

      // Subtle forward direction arrows painted on the tarmac every 10 spline points
      for (let i = startIdx; i < endIdx; i += 10) {
        const pt = trackSpline[i % N];
        const angle = Math.atan2(pt.ty, pt.tx);
        ctx.save();
        ctx.translate(pt.x, pt.y);
        ctx.rotate(angle);
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(-10, -14);
        ctx.lineTo(8, 0);
        ctx.lineTo(-10, 14);
        ctx.stroke();
        ctx.restore();
      }
    }

    function drawCornerMarkersAndFinishGantry(trackSpline, trackWidth) {
      const N = trackSpline.length;

      // Draw Corner Turn Tags (T1..T19) & Bright Yellow/Red Apex Chevron Boards on the outer verge
      for (let i = 0; i < N; i++) {
        const pt = trackSpline[i];
        if (!pt.isWpStart) continue;

        // Draw high-visibility Apex Chevron Board on sharp turns
        if (pt.chevron) {
          const sideSign = pt.chevron === 'L' ? 1 : -1; // Outer side of the turn
          const boardX = pt.x + pt.nx * sideSign * (trackWidth * 0.66);
          const boardY = pt.y + pt.ny * sideSign * (trackWidth * 0.66);
          const turnAngle = Math.atan2(pt.ty, pt.tx);

          ctx.save();
          ctx.translate(boardX, boardY);
          ctx.rotate(turnAngle);
          // Red & Yellow Flashing Apex Signboard
          ctx.fillStyle = '#0f172a';
          ctx.fillRect(-24, -10, 48, 20);
          ctx.strokeStyle = '#facc15';
          ctx.lineWidth = 2;
          ctx.strokeRect(-24, -10, 48, 20);

          ctx.fillStyle = '#facc15';
          ctx.font = 'bold 11px monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(pt.chevron === 'L' ? '◀ LEFT' : 'RIGHT ▶', 0, 0);
          ctx.restore();
        }

        // Draw Turn Number Painted on the Tarmac (e.g., T1, T6 HAIRPIN, T18 RASCASSE)
        if (pt.turnTag) {
          ctx.save();
          ctx.translate(pt.x, pt.y);
          ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
          const tagW = Math.max(38, pt.turnTag.length * 8 + 12);
          ctx.fillRect(-tagW / 2, -11, tagW, 22);
          ctx.strokeStyle = pt.turnTag === 'FINISH' ? '#22c55e' : '#38bdf8';
          ctx.lineWidth = 1.5;
          ctx.strokeRect(-tagW / 2, -11, tagW, 22);

          ctx.fillStyle = pt.turnTag === 'FINISH' ? '#4ade80' : '#f8fafc';
          ctx.font = 'bold 11px monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(pt.turnTag, 0, 0);
          ctx.restore();
        }
      }

      // Draw Unmistakable Start / Finish Checkered Line + Overhead F1 Light Gantry at index 0
      const sf = trackSpline[0];
      ctx.save();
      ctx.translate(sf.x, sf.y);
      ctx.rotate(Math.atan2(sf.ty, sf.tx));

      const checkerRows = 16;
      const boxSize = (trackWidth - 10) / checkerRows;
      for (let r = 0; r < checkerRows; r++) {
        for (let c = 0; c < 4; c++) {
          ctx.fillStyle = ((r + c) % 2 === 0) ? '#ffffff' : '#0f172a';
          ctx.fillRect(-16 + c * 8, -(trackWidth - 10) / 2 + r * boxSize, 8, boxSize);
        }
      }

      // Overhead Start/Finish Gantry Bridge with 5 Red/Green F1 Lights
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-8, -trackWidth * 0.54, 16, trackWidth * 1.08);
      ctx.strokeStyle = '#facc15';
      ctx.lineWidth = 2;
      ctx.strokeRect(-8, -trackWidth * 0.54, 16, trackWidth * 1.08);
      for (let l = -2; l <= 2; l++) {
        ctx.fillStyle = '#22c55e';
        ctx.beginPath();
        ctx.arc(0, l * 28, 5, 0, Math.PI * 2);
        ctx.fill();
      }

      // 8-Car F1 Starting Grid Boxes behind the start line
      ctx.strokeStyle = 'rgba(248, 250, 252, 0.55)';
      ctx.lineWidth = 2;
      for (let slot = 0; slot < 8; slot++) {
        const row = Math.floor(slot / 2);
        const side = (slot % 2 === 0) ? -1 : 1;
        const gx = -62 - row * 56 - (slot % 2) * 24;
        const gy = side * (trackWidth * 0.22);
        ctx.strokeRect(gx - 18, gy - 12, 36, 24);
      }
      ctx.restore();
    }

    function drawTrackAndWorld(camX, camY) {
      const active = getActiveTrack();
      const trackSpline = active.pts;
      const trackWidth = active.cfg.trackWidth;
      const curbWidth = active.cfg.curbWidth;
      const curbAltColor = active.cfg.sceneryType === 'monaco' ? '#0284c7' : '#dc2626';

      // Ground Background
      ctx.fillStyle = active.cfg.groundBg;
      ctx.fillRect(0, 0, viewW, viewH);

      const tileSize = 64;
      const startTileX = Math.floor(camX / tileSize) * tileSize;
      const startTileY = Math.floor(camY / tileSize) * tileSize;

      ctx.fillStyle = active.cfg.groundTile;
      for (let gx = startTileX; gx < camX + viewW + tileSize; gx += tileSize) {
        for (let gy = startTileY; gy < camY + viewH + tileSize; gy += tileSize) {
          if (((Math.floor(gx / tileSize) + Math.floor(gy / tileSize)) & 1) === 0) {
            ctx.fillRect(Math.floor(gx - camX), Math.floor(gy - camY), tileSize, tileSize);
          }
        }
      }

      ctx.save();
      ctx.translate(-Math.floor(camX), -Math.floor(camY));

      const N = trackSpline.length;

      // Base Track Pass
      drawTrackSegmentRange(trackSpline, 0, N, trackWidth, curbWidth, active.cfg.runoffColor, curbAltColor, false);

      // If Suzuka, find the Overpass Bridge range (around waypoint 19) and re-draw it ON TOP of the Underpass
      // so the figure-8 crossover is 100% clear and never looks like a 4-way intersection!
      let bridgeStart = -1, bridgeEnd = -1;
      for (let i = 0; i < N; i++) {
        if (trackSpline[i].bridge) {
          if (bridgeStart === -1) bridgeStart = Math.max(0, i - 14);
          bridgeEnd = Math.min(N - 1, i + 14);
        }
      }

      // Draw Corner Turn Tags, Outer Chevron Arrows & Finish Gantry
      drawCornerMarkersAndFinishGantry(trackSpline, trackWidth);

      // Skid Marks
      for (let i = 0; i < skidMarks.length; i++) {
        const sm = skidMarks[i];
        ctx.fillStyle = sm.color;
        ctx.fillRect(Math.floor(sm.x1), Math.floor(sm.y1), 4, 4);
        ctx.fillRect(Math.floor(sm.x2), Math.floor(sm.y2), 4, 4);
      }

      // Tire Smoke Particles
      for (let i = 0; i < smokeParticles.length; i++) {
        const p = smokeParticles[i];
        ctx.fillStyle = p.color;
        ctx.globalAlpha = Math.max(0, p.alpha);
        const s = Math.floor(p.size);
        ctx.fillRect(Math.floor(p.x - s / 2), Math.floor(p.y - s / 2), s, s);
      }
      ctx.globalAlpha = 1.0;

      // Check if player car is currently in the Suzuka Underpass (so the Overpass bridge renders over the car!)
      const carInUnderpass = Boolean(trackSpline[car.closestSplineIdx] && trackSpline[car.closestSplineIdx].underpass);

      if (carInUnderpass) {
        if (ghostCarState.visible) drawGhostCar(ghostCarState.x, ghostCarState.y, ghostCarState.angle);
        drawPixelCar(car.x, car.y, car.angle, CAR_SPECS[selectedCarKey], car.isDrifting, car.drsActive);
      }

      // Render Suzuka Overpass Bridge Deck on top of Underpass
      if (bridgeStart !== -1 && bridgeEnd !== -1) {
        drawTrackSegmentRange(trackSpline, bridgeStart, bridgeEnd, trackWidth, curbWidth, active.cfg.runoffColor, curbAltColor, true);
      }

      if (!carInUnderpass) {
        if (ghostCarState.visible) drawGhostCar(ghostCarState.x, ghostCarState.y, ghostCarState.angle);
        drawPixelCar(car.x, car.y, car.angle, CAR_SPECS[selectedCarKey], car.isDrifting, car.drsActive);
      }

      // Scenery Items
      const sceneryItems = active.scenery;
      for (let i = 0; i < sceneryItems.length; i++) {
        const item = sceneryItems[i];
        if (
          item.x < camX - 60 || item.x > camX + viewW + 60 ||
          item.y < camY - 60 || item.y > camY + viewH + 60
        ) continue;

        if (item.type === 'primary') {
          if (active.cfg.sceneryType === 'monaco') {
            ctx.fillStyle = 'rgba(0,0,0,0.35)';
            ctx.fillRect(Math.floor(item.x - item.size / 2 + 3), Math.floor(item.y - item.size / 3 + 3), item.size, Math.floor(item.size * 0.65));
            ctx.fillStyle = item.shade;
            ctx.fillRect(Math.floor(item.x - item.size / 2), Math.floor(item.y - item.size / 3), item.size, Math.floor(item.size * 0.65));
            ctx.fillStyle = '#38bdf8';
            ctx.fillRect(Math.floor(item.x - item.size / 4), Math.floor(item.y - item.size / 5), Math.floor(item.size / 2), 4);
          } else {
            ctx.fillStyle = 'rgba(0,0,0,0.35)';
            ctx.fillRect(Math.floor(item.x - item.size / 2 + 4), Math.floor(item.y - item.size / 2 + 4), item.size, item.size);
            ctx.fillStyle = item.shade;
            ctx.fillRect(Math.floor(item.x - item.size / 2), Math.floor(item.y - item.size / 2), item.size, item.size);
            ctx.fillStyle = '#22c55e';
            ctx.fillRect(Math.floor(item.x - item.size / 4), Math.floor(item.y - item.size / 4), Math.floor(item.size / 2), Math.floor(item.size / 2));
          }
        } else {
          ctx.fillStyle = '#e2e8f0';
          ctx.fillRect(Math.floor(item.x - 14), Math.floor(item.y - 14), 28, 28);
          ctx.fillStyle = active.cfg.sceneryType === 'suzuka' ? '#0284c7' : '#dc2626';
          ctx.fillRect(Math.floor(item.x - 14), Math.floor(item.y - 14), 28, 8);
        }
      }

      ctx.restore();
    }

    function drawGhostCar(x, y, angle) {
      ctx.save();
      ctx.translate(Math.floor(x), Math.floor(y));
      ctx.rotate(angle);
      ctx.globalAlpha = 0.55;

      ctx.fillStyle = '#22d3ee';
      ctx.fillRect(-16, -9, 32, 18);
      ctx.fillRect(14, -7, 4, 14);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(-12, -2, 28, 4);

      ctx.fillStyle = '#0891b2';
      ctx.fillRect(-4, -6, 10, 12);

      ctx.fillStyle = '#06b6d4';
      ctx.fillRect(-17, -10, 4, 20);

      ctx.restore();
    }

    function drawPixelCar(x, y, angle, spec, isDrifting, drsActive) {
      ctx.save();
      ctx.translate(Math.floor(x), Math.floor(y));
      ctx.rotate(angle);

      ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
      ctx.fillRect(-15, -8, 32, 20);

      ctx.fillStyle = '#090d16';
      ctx.fillRect(-13, -12, 8, 4);
      ctx.fillRect(-13, 8, 8, 4);
      ctx.fillRect(6, -12, 8, 4);
      ctx.fillRect(6, 8, 8, 4);

      ctx.fillStyle = spec.colorMain;
      ctx.fillRect(-16, -9, 32, 18);
      ctx.fillRect(14, -7, 4, 14);

      ctx.fillStyle = spec.colorStripe;
      ctx.fillRect(-12, -2, 28, 4);

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-4, -6, 10, 12);
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(1, -5, 4, 10);

      ctx.fillStyle = drsActive ? '#22c55e' : spec.colorSpoiler;
      ctx.fillRect(-17, -10, 4, 20);

      if (isDrifting) {
        ctx.fillStyle = '#fbbf24';
        ctx.fillRect(-21, -5, 4, 3);
        ctx.fillRect(-21, 2, 4, 3);
      }

      ctx.restore();
    }

    function drawMinimap() {
      miniCtx.clearRect(0, 0, minimapCanvas.width, minimapCanvas.height);
      const active = getActiveTrack();
      const trackSpline = active.pts;
      const b = active.bounds;
      const pad = 8;
      const wSpan = Math.max(1, b.maxX - b.minX);
      const hSpan = Math.max(1, b.maxY - b.minY);
      const scale = Math.min((minimapCanvas.width - pad * 2) / wSpan, (minimapCanvas.height - pad * 2) / hSpan);
      const offsetX = (minimapCanvas.width - wSpan * scale) * 0.5 - b.minX * scale;
      const offsetY = (minimapCanvas.height - hSpan * scale) * 0.5 - b.minY * scale;

      miniCtx.save();
      miniCtx.lineCap = 'round';
      miniCtx.lineJoin = 'round';

      const N = trackSpline.length;
      for (let i = 0; i < N; i += 2) {
        const p1 = trackSpline[i];
        const p2 = trackSpline[(i + 2) % N];
        const mx1 = p1.x * scale + offsetX;
        const my1 = p1.y * scale + offsetY;
        const mx2 = p2.x * scale + offsetX;
        const my2 = p2.y * scale + offsetY;

        miniCtx.beginPath();
        miniCtx.moveTo(mx1, my1);
        miniCtx.lineTo(mx2, my2);
        miniCtx.lineWidth = 2.4;
        if (p1.sector === 1) miniCtx.strokeStyle = 'rgba(239, 68, 68, 0.92)';
        else if (p1.sector === 2) miniCtx.strokeStyle = 'rgba(56, 189, 248, 0.92)';
        else miniCtx.strokeStyle = 'rgba(250, 204, 21, 0.92)';
        miniCtx.stroke();
      }

      const sf = trackSpline[0];
      miniCtx.fillStyle = '#22c55e';
      miniCtx.fillRect(sf.x * scale + offsetX - 2.5, sf.y * scale + offsetY - 2.5, 5, 5);

      if (ghostCarState.visible) {
        const gx = ghostCarState.x * scale + offsetX;
        const gy = ghostCarState.y * scale + offsetY;
        miniCtx.fillStyle = '#22d3ee';
        miniCtx.beginPath();
        miniCtx.arc(gx, gy, 2.5, 0, Math.PI * 2);
        miniCtx.fill();
      }

      const px = car.x * scale + offsetX;
      const py = car.y * scale + offsetY;
      miniCtx.fillStyle = car.isDrifting ? '#fde047' : '#ffffff';
      miniCtx.beginPath();
      miniCtx.arc(px, py, 3.2, 0, Math.PI * 2);
      miniCtx.fill();
      miniCtx.strokeStyle = '#0f172a';
      miniCtx.lineWidth = 1.2;
      miniCtx.stroke();

      miniCtx.restore();
    }

    // =========================================================================
    // 9. MAIN GAME LOOP
    // =========================================================================
    let lastFrameTime = performance.now();
    let camX = 0;
    let camY = 0;

    function gameLoop(now) {
      const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
      lastFrameTime = now;

      if (garageModal.classList.contains('hidden') && resultModal.classList.contains('hidden')) {
        updatePhysics(dt);
      } else {
        updateAudio(0, false, false);
      }

      const lookAheadX = car.vx * 0.16;
      const lookAheadY = car.vy * 0.16;
      const targetCamX = car.x + lookAheadX - viewW / 2;
      const targetCamY = car.y + lookAheadY - viewH / 2;
      camX += (targetCamX - camX) * Math.min(1, dt * 8);
      camY += (targetCamY - camY) * Math.min(1, dt * 8);

      drawTrackAndWorld(camX, camY);
      drawMinimap();

      requestAnimationFrame(gameLoop);
    }

    window.onload = () => {
      resizeCanvas();
      updateAutoGasUI();
      updateMenuSummary();
      resetCarToStart();
      camX = car.x - viewW / 2;
      camY = car.y - viewH / 2;
      requestAnimationFrame(gameLoop);
    };
  </script>
</body>
</html>
